# Microsoft Entra sign-in.
# - Leave VITE_ENTRA_AUTHORITY unset to use Entra External ID (CIAM) built from
#   the tenant name + GUID below (default).
# - Set VITE_ENTRA_AUTHORITY to a workforce authority to use the app created by
#   the azure-entra-app.yml workflow, e.g.
#   VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenantId>/v2.0
#   (the Azure deploy workflow sets this automatically once that app exists).
VITE_ENTRA_TENANT_NAME=enterpriseds
VITE_ENTRA_TENANT_ID=b9791c7d-dd6c-4190-b1bb-dbbd1996bc2e
VITE_ENTRA_CLIENT_ID=59465948-6e95-4124-984e-a43acade2fa9
# VITE_ENTRA_AUTHORITY=

# Voice (ElevenLabs Conversational AI) — server-only; set these in Lovable → Secrets.
# ELEVENLABS_API_KEY          — required for live voice calls (never exposed to the browser).
# ELEVENLABS_DEFAULT_VOICE_ID — fallback voice used until agents get real ElevenLabs voice ids.
# ELEVENLABS_AGENT_LLM        — optional; the Conversational-AI brain model. Defaults to gpt-4o-mini.
